# Các biến NEXT_PUBLIC_* có thể xuất hiện trong mã gửi tới trình duyệt.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Secret ngẫu nhiên tối thiểu 32 ký tự, dùng để ánh xạ số điện thoại thành email Auth nội bộ.
# Không thay đổi secret này sau khi đã có user, nếu không các user cũ sẽ không đăng nhập được.
AUTH_IDENTIFIER_SECRET=

# Chỉ dùng phía server nếu một tính năng quản trị sau này thực sự cần.
# API đăng ký/đăng nhập hiện tại không sử dụng service-role key.
SUPABASE_SERVICE_ROLE_KEY=
